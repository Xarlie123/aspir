src/datasets/tmp_downloaded_datasets/
*.mat
*.zip
data/
exported_experiments/
# Experiments directory - ignore results but track configs
experiments/
!experiments/.keep
!experiments/**/*.batch_config
!experiments/**/*.single_test_config
# Legacy export directories (now superseded by Generated_outputs/)
exported_batch_configs/
exported_batch_results/
exported_settings/
